{%- comment -%} RECENTLY ADDED strip from _data/recent.yml ([{project,title,caption,src_800,video?,date}], newest first). Hidden when empty. Native scroll-snap; the scroller is keyboard focusable. {%- endcomment -%}
{%- assign recents = site.data.recent -%}
{%- if recents and recents.size > 0 -%}
  <section class="home-sec" aria-labelledby="home-recent">
    <header class="home-sec__head">
      <p class="eyebrow">Feed</p>
      <h2 id="home-recent" data-fx="split">Recently added</h2>
    </header>
    <ul class="hr" tabindex="0" role="list" aria-label="Recently added items, scroll sideways">
      {%- for r in recents limit: 16 -%}
        {%- assign rp = site.projects | where: 'slug', r.project | first -%}
        {%- assign rc = rp.category | first | default: 'sciml' -%}
        <li class="hr__item">
          <a
            class="hr__tile raised fx-spot"
            href="{{ '/projects/' | append: r.project | append: '/' | relative_url }}"
            style="--c: var(--cat-{{ rc }});"
          >
            <span class="hr__media">
              {%- if r.src_800 -%}<img src="{{ r.src_800 | relative_url }}" alt="" loading="lazy" decoding="async">{%- endif -%}
              {%- if r.video -%}
                <span class="hr__play" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M7 5l12 7-12 7z"/>
                  </svg>
                </span>
              {%- endif -%}
            </span>
            <span class="hr__date mono">{{ r.date | date: '%Y-%m-%d' }}</span>
            <span class="hr__proj">{{ r.title | default: rp.title | escape }}</span>
            {%- if r.caption and r.caption != '' -%}
              <span class="hr__cap">{{ r.caption | escape }}</span>
            {%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </section>
{%- endif -%}
