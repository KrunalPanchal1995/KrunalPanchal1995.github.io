{%- comment -%} INTERACTIVE teasers (no iframes): Research world, Reel, Playground, Math Visual Studio (full window). {%- endcomment -%}
<section class="home-sec" aria-labelledby="home-tz">
  <header class="home-sec__head">
    <p class="eyebrow">Interactive</p>
    <h2 id="home-tz" data-fx="split">Try it live</h2>
  </header>
  <ul class="ht" data-fx-stagger>
    <li>
      <a class="ht__card raised fx-spot" data-fx="reveal" href="{{ '/studio/' | relative_url }}">
        <svg
          class="ht__ico"
          width="40"
          height="40"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z"/><path d="M12 12l8-4.5M12 12L4 7.5M12 12v9"/>
        </svg>
        <span class="ht__label">Math Visual Studio</span>
        <span class="btn-cta btn-cta-primary ht__go">Launch</span>
      </a>
    </li>
    <li>
      <a class="ht__card raised fx-spot" data-fx="reveal" href="{{ '/world/' | relative_url }}">
        <svg
          class="ht__ico"
          width="40"
          height="40"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3.2 3 14.8 0 18M12 3c-3 3.2-3 14.8 0 18"/>
        </svg>
        <span class="ht__label">Research world</span>
        <span class="btn-cta btn-cta-primary ht__go">Launch</span>
      </a>
    </li>
    <li>
      <a class="ht__card raised fx-spot" data-fx="reveal" href="{{ '/reel/' | relative_url }}">
        <svg
          class="ht__ico"
          width="40"
          height="40"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="3" y="5" width="18" height="14" rx="2"/><path d="M10 9.5v5l4.5-2.5z"/>
        </svg>
        <span class="ht__label">Reel</span>
        <span class="btn-cta btn-cta-primary ht__go">Watch</span>
      </a>
    </li>
    <li>
      <a class="ht__card raised fx-spot" data-fx="reveal" href="{{ '/playground/' | relative_url }}">
        <svg
          class="ht__ico"
          width="40"
          height="40"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M3 17c3 0 3-10 6-10s3 10 6 10 3-10 6-10"/><path d="M3 21h18"/>
        </svg>
        <span class="ht__label">Playground</span>
        <span class="btn-cta btn-cta-primary ht__go">Launch</span>
      </a>
    </li>
  </ul>
</section>
